# Repository root override. Leave unset to detect from the package location.
# AIRCAST_ROOT=/absolute/path/to/AirCast India

AIRCAST_API_HOST=0.0.0.0
AIRCAST_API_PORT=8000
AIRCAST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AIRCAST_TIMEZONE=Asia/Kolkata

# Optional. The application runs without MongoDB.
# AIRCAST_MONGODB_URI=

# PySpark / Java. Set after installing OpenJDK 17.
# JAVA_HOME=/opt/homebrew/opt/openjdk@17
# SPARK_LOCAL_IP=127.0.0.1
