# Base URL of the AirCast HTTP API. No trailing slash and no secrets.
# OpenAQ keys, database credentials, and model files stay on the backend.
#
# Leave this unset until the API is running. The interface then shows
# "Awaiting backend" and does not invent observations, pipeline status,
# predictions, or metrics.
#
VITE_API_BASE_URL=http://127.0.0.1:8000
